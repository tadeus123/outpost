# Stripe — https://dashboard.stripe.com/test/apikeys (both keys from the same account)
STRIPE_SECRET_KEY=sk_test_your_secret_here
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_here

# Local dev
CLIENT_URL=http://localhost:5173
PORT=4242

# Vercel: set these in Project → Settings → Environment Variables
# CLIENT_URL=https://your-domain.vercel.app  (or custom domain, no trailing slash)
# STRIPE_SECRET_KEY and VITE_STRIPE_PUBLISHABLE_KEY required for checkout
