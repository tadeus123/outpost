# Stripe — https://dashboard.stripe.com/test/apikeys (both keys from the same account)
STRIPE_SECRET_KEY=sk_test_your_secret_here
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_here

# Local dev
CLIENT_URL=http://localhost:5173
PORT=4242

# Supabase — Project Settings → API (Outpost project linked via supabase/)
# Server API needs URL + service role (never expose service role to the browser)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret

# Optional alias (if you copied Vercel/Next-style names — server accepts either)
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Database schema: commit supabase/migrations/ and push to main with GitHub integration
# “Deploy to production” enabled in Supabase → Integrations → GitHub

# Vercel: CLIENT_URL, STRIPE_*, SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY
