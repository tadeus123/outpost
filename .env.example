# Stripe — https://dashboard.stripe.com/test/apikeys (both keys from the same account)
STRIPE_SECRET_KEY=sk_test_your_secret_here
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_here

# Local dev
CLIENT_URL=http://localhost:5173
PORT=4242

# Supabase — Project Settings → API (same project linked in supabase/config.toml via GitHub)
# Required for /cities “whisper a city” → POST /api/city-suggestion
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret

# Database schema: commit files under supabase/migrations/ and push to main.
# In Supabase Dashboard → Integrations → GitHub: working directory ".", enable “Deploy to production”.

# Vercel: set these in Project → Settings → Environment Variables
# CLIENT_URL=https://your-domain.vercel.app  (or custom domain, no trailing slash)
# STRIPE_SECRET_KEY, VITE_STRIPE_PUBLISHABLE_KEY, SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY
