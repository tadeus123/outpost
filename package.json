  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api -c blue,gray \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "vite",
    "dev:api": "node server/index.js",
    "build": "vite build",
    "lint": "eslint .",
